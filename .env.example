# =========================================================
# Resonance - Export Outreach & Operations
# Environment Configuration Template
# =========================================================

# --- Google Gemini AI (Required for AI Intelligence) ---
# Obtain from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
CLASSIFICATION_BATCH_SIZE=20
QUOTA_SAFE_MODE=true

# --- Buyer Discovery: Google Custom Search API (Recommended) ---
# Obtain from Google Cloud Console & Programmable Search Engine:
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# --- Buyer Discovery: Optional Social Providers (Optional) ---
FACEBOOK_ACCESS_TOKEN=
LINKEDIN_ACCESS_TOKEN=

# --- Gmail SMTP Outreach (Required for Email Dispatch) ---
# Use a 16-character Google App Password (NOT your standard account password):
# Generate at: https://myaccount.google.com/apppasswords
GMAIL_EMAIL=
GMAIL_APP_PASSWORD=
MONITORING_CC_EMAIL=

# --- Outreach Safety & Guardrails ---
DRY_RUN=true
DAILY_SEND_LIMIT=100
SEND_DELAY_SECONDS=5
PRESENTATION_PATH=assets/company_presentation.pdf

# --- Target Product & Search Keyword ---
SEARCH_KEYWORD=Singing Bowls

# --- Web Server & Production Deployment ---
HOST=0.0.0.0
PORT=8000
DEBUG=false
CORS_ALLOWED_ORIGINS=
